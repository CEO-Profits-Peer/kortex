{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grid-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        "dist",
        "-s",
        "-l",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "cwd": "app"
    }
  ]
}
