# =============================================================================
# pipeline/.env   ·   Werte für den Ingestion-Service (Python)
#
# HIER liegen die echten Geheimnisse. Diese Datei laeuft nur auf deinem Rechner
# und in GitHub Actions - nie in der App, nie im Browser, nie im Repo.
#
# Fuer GitHub Actions werden dieselben Werte als "Repository Secrets"
# hinterlegt:  Repo -> Settings -> Secrets and variables -> Actions
# =============================================================================

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://DEIN-PROJECT-REF.supabase.co

# Dashboard -> Project Settings -> API -> service_role
# Dieser Key UMGEHT JEDE RLS-Regel. Er ist der Generalschluessel zur Datenbank.
# Niemals in app/.env, niemals in eine Chat-Nachricht, niemals ins Repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini ------------------------------------------------------------------
# aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- Sicherheitsnetz gegen durchgedrehte Jobs --------------------------------
# Eine Schleife im Ingest kann ueber Nacht das gesamte Kontingent verbrennen.
MAX_ITEMS_PER_RUN=250
MAX_GEMINI_CALLS_PER_RUN=400
DRY_RUN=false

# --- Pipeline-Verhalten ------------------------------------------------------
INGEST_LANGUAGES=de,en
DEDUPE_SIMILARITY_THRESHOLD=0.86
# erste 500 Cards gibt ein Mensch frei, danach kategorieweise umstellen
AUTO_APPROVE=false

# --- Spaeter (v0.5, noch leer lassen) ----------------------------------------
GOOGLE_TTS_CREDENTIALS_JSON=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
