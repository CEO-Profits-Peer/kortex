# =============================================================================
# app/.env   ·   Werte für die Expo-App
#
# ACHTUNG, die wichtigste Regel im ganzen Projekt:
# ALLES in dieser Datei landet im App-Bundle und ist damit ÖFFENTLICH.
# Jeder, der die APK entpackt, liest diese Werte im Klartext. Es gibt keine
# geheimen Werte in einer Client-App - nur solche, die geheim aussehen.
#
# Deshalb steht hier ausschliesslich der anon key. Der ist absichtlich
# oeffentlich; geschuetzt wird nicht der Key, sondern die Zeile dahinter
# (RLS in supabase/migrations/0002_rls.sql).
#
# Der service_role key gehoert NIEMALS hierher -> pipeline/.env
#
# Expo liest nur Variablen mit dem Praefix EXPO_PUBLIC_. Das ist keine
# Einschraenkung, sondern eine Warnung im Namen.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Analytics (Region EU waehlen beim Anlegen!) ------------------------------
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Crash-Reports -----------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=

# --- Umgebung ----------------------------------------------------------------
# dev | preview | production  - steuert Logging und Feature Flags
EXPO_PUBLIC_ENV=dev
